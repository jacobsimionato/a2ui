{
  "name": "@a2ui/catalog-reuse-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wireit",
    "serve": "tsx server/server.ts",
    "test": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@a2ui/angular": "workspace:*",
    "@a2ui/markdown-it": "workspace:*",
    "@a2ui/web_core": "workspace:*",
    "@angular/common": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "express": "^5.2.1",
    "tslib": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
    "@angular/cli": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/compiler-cli": "^21.2.5",
    "@playwright/test": "1.58.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "wireit": "^0.15.0-pre.2"
  },
  "wireit": {
    "build": {
      "command": "yarn workspace angular-a2ui ng build catalog-reuse",
      "dependencies": [
        "../../../../../renderers/angular:build"
      ],
      "files": [
        "src/**/*",
        "tsconfig.app.json"
      ],
      "output": [
        "dist"
      ]
    }
  }
}
