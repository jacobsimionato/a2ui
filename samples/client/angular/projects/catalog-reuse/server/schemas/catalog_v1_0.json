{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/catalogs/common/v1_0/catalog.json",
  "protocolVersion": "1.0",
  "catalogId": "https://example.com/catalogs/common/v1_0/catalog.json",
  "title": "Common Catalog (v1.0 Protocol)",
  "description": "Catalog demonstrating shared components under A2UI v1.0 specification.",
  "components": {
    "ContainerCard": {
      "type": "object",
      "properties": {
        "component": {"const": "ContainerCard"},
        "title": {"$ref": "common_types.json#/$defs/DynamicString"},
        "subtitle": {"$ref": "common_types.json#/$defs/DynamicString"},
        "badge": {"$ref": "common_types.json#/$defs/DynamicString"},
        "child": {"$ref": "common_types.json#/$defs/Child"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      },
      "required": ["component"]
    },
    "SmartInput": {
      "type": "object",
      "properties": {
        "component": {"const": "SmartInput"},
        "label": {"$ref": "common_types.json#/$defs/DynamicString"},
        "placeholder": {"$ref": "common_types.json#/$defs/DynamicString"},
        "value": {"$ref": "common_types.json#/$defs/DataBinding"},
        "checks": {
          "type": "array",
          "items": {"$ref": "common_types.json#/$defs/CheckRule"}
        }
      },
      "required": ["component", "label"]
    },
    "RatingSlider": {
      "type": "object",
      "properties": {
        "component": {"const": "RatingSlider"},
        "label": {"$ref": "common_types.json#/$defs/DynamicString"},
        "min": {"type": "number", "default": 0},
        "max": {"type": "number", "default": 10},
        "value": {"$ref": "common_types.json#/$defs/DataBinding"}
      },
      "required": ["component", "label"]
    },
    "DynamicRepeater": {
      "type": "object",
      "properties": {
        "component": {"const": "DynamicRepeater"},
        "title": {"$ref": "common_types.json#/$defs/DynamicString"},
        "children": {"$ref": "common_types.json#/$defs/ChildList"}
      },
      "required": ["component", "children"]
    },
    "ActionTrigger": {
      "type": "object",
      "properties": {
        "component": {"const": "ActionTrigger"},
        "label": {"$ref": "common_types.json#/$defs/DynamicString"},
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "danger"],
          "default": "primary"
        },
        "disabled": {"$ref": "common_types.json#/$defs/DynamicBoolean"},
        "action": {"$ref": "common_types.json#/$defs/Action"}
      },
      "required": ["component", "label"]
    },
    "ComputedSummary": {
      "type": "object",
      "properties": {
        "component": {"const": "ComputedSummary"},
        "title": {"$ref": "common_types.json#/$defs/DynamicString"},
        "greeting": {"$ref": "common_types.json#/$defs/DynamicString"},
        "total": {"$ref": "common_types.json#/$defs/DynamicNumber"}
      },
      "required": ["component", "title"]
    },
    "StatusBadge": {
      "type": "object",
      "properties": {
        "component": {"const": "StatusBadge"},
        "text": {"$ref": "common_types.json#/$defs/DynamicString"},
        "variant": {"type": "string", "enum": ["success", "warning", "info"], "default": "info"}
      },
      "required": ["component", "text"]
    }
  },
  "functions": {
    "formatGreeting": {
      "name": "formatGreeting",
      "returnType": "string",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {"type": "string"}
        }
      }
    },
    "calculateTotal": {
      "name": "calculateTotal",
      "returnType": "number",
      "parameters": {
        "type": "object",
        "properties": {
          "quantity": {"type": "number"},
          "unitPrice": {"type": "number"}
        }
      }
    },
    "checkRequiredV1": {
      "name": "checkRequiredV1",
      "returnType": "object",
      "parameters": {
        "type": "object",
        "properties": {
          "value": {"type": "string"}
        }
      }
    }
  }
}
