{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/catalogs/v1_extension/catalog.json",
  "protocolVersion": "1.0",
  "catalogId": "https://example.com/catalogs/v1_extension/catalog.json",
  "title": "Extension Catalog (v1.0 Protocol)",
  "description": "Catalog providing v1.0-specific extension components.",
  "components": {
    "MetricGauge": {
      "type": "object",
      "properties": {
        "component": {"const": "MetricGauge"},
        "label": {"$ref": "common_types.json#/$defs/DynamicString"},
        "score": {"$ref": "common_types.json#/$defs/DynamicNumber"},
        "maxScore": {"$ref": "common_types.json#/$defs/DynamicNumber"},
        "trend": {"type": "string", "enum": ["up", "down", "stable"], "default": "stable"}
      },
      "required": ["component", "label", "score"]
    }
  },
  "functions": {}
}
